# Server
PORT=3000
NODE_ENV=development

# Must match Laravel's JWT_SECRET exactly — Node verifies the same JWTs
# Laravel issues (tymon/jwt-auth, HS256), independent of Laravel's DB.
JWT_SECRET=

# Must match Laravel's INTERNAL_SERVICE_TOKEN exactly — sent as
# X-Internal-Token on cron-triggered calls to Laravel (no user JWT in
# context) and required on this service's own /api/notifications/send
# endpoint (which only Laravel should call).
INTERNAL_SERVICE_TOKEN=your_internal_service_token_here

# Laravel API base URL
LARAVEL_API_URL=http://localhost:8000/api

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Task Management Platform

# Analytics in-memory cache TTL, in milliseconds (default 1 hour)
ANALYTICS_CACHE_TTL_MS=3600000
